{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gtm-engine",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "GTM_TOKENS",
      "id": "96993adb1c524a119c58ee5ef017bfc5"
    }
  ],
  "vars": {
    "APP_URL": "https://gtm-engine.ajay-singh-086.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
